pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('cilm-service') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Test') {
            steps {
                dir('cilm-service') {
                    sh 'mvn test'
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('cilm-service') {
                    sh 'docker build -t cilm-service:latest .'
                }
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    docker stop cilm-service || true
                    docker rm cilm-service || true

                    docker run -d \
                      --name cilm-service \
                      --add-host=host.docker.internal:host-gateway \
                      -p 8081:8081 \
                      -e DB_URL="jdbc:mysql://host.docker.internal:3306/cilm" \
                      -e DB_USERNAME="root" \
                      -e DB_PASSWORD="root" \
                      cilm-service:latest

                    echo "Waiting for application to start..."
                    sleep 15

                    echo "Container status:"
                    docker ps -a --filter "name=cilm-service"

                    if [ "$(docker inspect -f '{{.State.Running}}' cilm-service)" != "true" ]; then
                        echo "Container failed to start!"
                        echo "Container logs:"
                        docker logs cilm-service
                        exit 1
                    fi

                    echo "Container is running successfully!"
                '''
            }
        }
    }

    post {
        success {
            echo 'Build, Test, Docker Build and Deployment completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check the console output.'
        }
    }
}
